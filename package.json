{
  "name": "jobpilot",
  "version": "0.2.0",
  "private": true,
  "description": "A local-first workspace for job discovery, resume tailoring, and application tracking.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davinh47/JobPilot.git"
  },
  "bugs": {
    "url": "https://github.com/davinh47/JobPilot/issues"
  },
  "homepage": "https://github.com/davinh47/JobPilot#readme",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "npm run extension:package && npm run pdf:worker",
    "dev": "node scripts/run-local.mjs dev",
    "prebuild": "npm run extension:package && npm run pdf:worker",
    "build": "next build",
    "start": "node scripts/run-local.mjs start",
    "lint": "eslint .",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx src/db/migrate.ts",
    "db:seed": "node --import tsx src/db/seed.ts",
    "db:demo": "node --import tsx src/db/demo.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "extension:package": "node scripts/package-extension.mjs",
    "pdf:worker": "node scripts/copy-pdf-worker.mjs",
    "resumes:backfill": "node --import tsx src/db/backfill-resume-versions.ts",
    "resumes:verify-exports": "node --import tsx scripts/verify-resume-exports.ts",
    "worker": "node --import tsx src/worker/index.ts",
    "worker:once": "node --import tsx src/worker/index.ts --once"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.17.4",
    "@napi-rs/canvas": "0.1.80",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "cheerio": "^1.2.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.11",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "pdfkit": "^0.19.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.11",
    "jszip": "^3.10.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "esbuild": "^0.25.12",
    "minimatch": "^10.2.5",
    "postcss": "^8.5.10",
    "sharp": "^0.35.0"
  }
}
