DATABASE_URL=file:./data/jobpilot.db
NEXT_PUBLIC_GITHUB_URL=https://github.com/davinh47/JobPilot

# Optional JSON pricing map in USD per million tokens. When omitted, usage is
# still tracked but estimated cost stays at zero.
# JOBPILOT_MODEL_PRICING={"model-name":{"input":1.0,"output":4.0,"cachedInput":0.1}}

# Optional for networks that cannot reach model APIs directly.
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
# NO_PROXY=127.0.0.1,localhost
