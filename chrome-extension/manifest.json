{
  "manifest_version": 3,
  "name": "JobPilot One-click Saver",
  "version": "0.1.0",
  "description": "Save the current job page to your local JobPilot workspace.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:3000/*", "http://localhost:3000/*"],
  "action": {
    "default_title": "Save to JobPilot",
    "default_popup": "popup.html"
  }
}
