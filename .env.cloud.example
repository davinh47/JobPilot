JOBPILOT_DEPLOYMENT=cloud
NEXT_PUBLIC_SITE_URL=https://app.example.com

# Turso or another hosted libSQL database.
DATABASE_URL=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=

# Supabase Auth and private Storage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUME_BUCKET=resumes
# Set to true only after enabling and configuring Supabase's Google provider.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Generate with: openssl rand -base64 32
JOBPILOT_SECRETS_KEY=
# Increment when rotating the active key. Keep old keys in JOBPILOT_SECRETS_KEYS
# until every account secret has been lazily re-encrypted.
JOBPILOT_SECRETS_KEY_VERSION=v1
# Example: {"v0":"old-base64-key","v1":"current-base64-key"}
JOBPILOT_SECRETS_KEYS={}
# Optional separate HMAC key for privacy-preserving API rate-limit identifiers.
JOBPILOT_RATE_LIMIT_KEY=

# Vercel adds this value to scheduled requests.
CRON_SECRET=

NEXT_PUBLIC_GITHUB_URL=https://github.com/davinh47/JobPilot

# Optional JSON pricing map in USD per million tokens.
# JOBPILOT_MODEL_PRICING={"model-name":{"input":1.0,"output":4.0,"cachedInput":0.1}}
