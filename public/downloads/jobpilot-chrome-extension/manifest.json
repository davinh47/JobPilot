{
  "manifest_version": 3,
  "name": "JobPilot One-click Saver",
  "version": "0.4.0",
  "description": "Save the current job page to your local or hosted JobPilot workspace.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "Save to JobPilot",
    "default_popup": "popup.html"
  }
}
